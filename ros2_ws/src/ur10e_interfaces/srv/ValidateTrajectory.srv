# ValidateTrajectory.srv

# 1. REQUEST (Input sent to the service)
# Desired EE trajectory path (flattened matrix or list of poses)
float64[] ee_positions_x
float64[] ee_positions_y
float64[] ee_positions_z
float64[] ee_quat
float64[] sim_time

# Configuration the arm is in when the trajectory starts, as
# [rail_m, shoulder_pan, shoulder_lift, elbow, wrist_1, wrist_2, wrist_3];
# the rail in metres, the six arm joints in radians. Same order as
# Validate_trajServer's joint_names.
#
# This is an INPUT, not something the server discovers. Inverse kinematics
# seeds each waypoint from the previous solution and the first from this
# pose, so a different start lands in a different solution branch and can
# change which waypoints are reachable. Sending it explicitly is what makes
# a validation result reproducible.
#
# Leave empty to start from the documented home pose. Any other length is
# rejected rather than guessed at.
float64[] q_start

---
# 2. RESPONSE (Output sent back to the main script)
bool success
string message
float64[] joint_velocities  # Approved velocity commands (flattened)