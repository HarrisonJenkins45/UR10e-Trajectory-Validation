# macOS
*DS_Store

# Screenshots and recordings
*.png
*.mp4

# colcon build artifacts. Generated by `colcon build`; never commit them.
# They embed absolute paths and CMake caches from whichever machine produced
# them, so a committed copy makes the workspace fail to build anywhere else.
# Matches the nested copies under src/ as well as the workspace-level ones.
build/
install/
log/

# Python bytecode
__pycache__/
*.py[cod]
